<?xml version="1.0" encoding="utf-8"?>
<!--
    No device-to-device or cloud transfer of app data. Credential material is
    encrypted at rest and must never leave the device through a platform backup;
    the encrypted backup/restore capability (milestone 9) is the only supported
    export path.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
