# Required: bearer token the Android app stores encrypted with Android Keystore.
GATEWAY_TOKEN=replace-with-a-long-random-token

# Provider routing: openai, gemini, or anthropic.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative provider examples.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Meta WhatsApp Cloud API. Keep these only on the gateway host.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v20.0

# Bind locally and put TLS in front, or provide a certificate/key directly.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8443
# TLS_CERT_FILE=/path/to/fullchain.pem
# TLS_KEY_FILE=/path/to/privkey.pem
